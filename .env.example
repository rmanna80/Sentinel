# Copy to .env in the folder you start the server from. Everything is optional.
# production refuses fixture (demo) data; demo accepts it and badges it everywhere.
SENTINEL_MODE=production
SENTINEL_PORT=8765
# SENTINEL_DATA_DIR=C:\Users\you\AppData\Local\Sentinel\server
# Score shows "Incomplete" below this share of completed checks.
SENTINEL_MIN_SCORE_COVERAGE=0.75
# Set to false to stop every integration from reaching the internet.
SENTINEL_OUTBOUND_ENABLED=true
# API keys are NOT configured here. Add them on the Integrations page (stored in Windows Credential Manager).
